@@ -15,6 +15,30 @@ struct proc *initproc;
 int nextpid = 1;
 struct spinlock pid_lock;
 
+int
+do_rand(unsigned long *ctx)
+{
+  long hi, lo, x;
+
+  x = (*ctx % 0x7ffffffe) + 1;
+  hi = x / 127773;
+  lo = x % 127773;
+  x = 16807 * lo - 2836 * hi;
+  if (x < 0)
+    x += 0x7fffffff;
+  x--;
+  *ctx = x;
+  return x;
+}
+
+unsigned long rand_next = 1;
+
+int
+rand(void)
+{
+  return do_rand(&rand_next);
+}
+
 extern void forkret(void);
 static void freeproc(struct proc *p);
 
@@ -124,6 +148,8 @@ allocproc(void)
 found:
   p->pid = allocpid();
   p->state = USED;
+  p->tickets = 10;
+  p->rounds = 0;
 
   // Allocate a trapframe page.
   if ((p->trapframe = (struct trapframe *)kalloc()) == 0) {
@@ -167,6 +193,8 @@ freeproc(struct proc *p)
   p->chan = 0;
   p->killed = 0;
   p->xstate = 0;
+  p->tickets = 0;
+  p->rounds = 0;
