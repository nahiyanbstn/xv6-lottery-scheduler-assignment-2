diff --git a/user/test_scheduler.c b/user/test_scheduler.c
new file mode 100644
index 0000000..615cb22
--- /dev/null
+++ b/user/test_scheduler.c
@@ -0,0 +1,20 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 2) {
+    fprintf(2, "usage: test_scheduler tickets\n");
+    exit(1);
+  }
+
+  int tickets = atoi(argv[1]);
+  if (tickets <= 0 || settickets(tickets) < 0) {
+    fprintf(2, "test_scheduler: tickets must be a positive integer\n");
+    exit(1);
+  }
+
+  for (;;)
+    ;
+}
